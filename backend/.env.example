DEBUG=False
SECRET_KEY=replace-this-with-a-secure-secret
ALLOWED_HOSTS=your-render-service.onrender.com
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-vercel-app.vercel.app

# Local development examples:
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Render PostgreSQL supplies this as an internal connection string.
DATABASE_URL=
DB_CONN_MAX_AGE=600

# Optional local PostgreSQL fallback when DATABASE_URL is not set.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
TIME_ZONE=Africa/Accra

# Keep false until the final custom domain HTTPS setup is verified end-to-end.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
